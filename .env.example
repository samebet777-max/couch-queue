# Copy to .env.local and fill in. These ship inside the app, so use read-only keys.

# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_TOKEN=

# Supabase project URL and anon (public) key, from Project Settings > API.
# Leave empty to keep the list on one phone only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
